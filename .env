# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=govtribe_platform
DB_USER=govtribe_user
DB_PASS=secure_password_123

# SAM.gov API Configuration
SAM_API_KEY=your_sam_api_key_here
SAM_API_ENVIRONMENT=prod
SAM_API_BASE_URL=https://api.sam.gov/opportunities/v2/search
SAM_API_ALPHA_URL=https://api-alpha.sam.gov/opportunities/v2/search

# Application Configuration
APP_NAME="Private GovTribe Platform"
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=America/Los_Angeles
APP_URL=http://localhost:8080

# Security Configuration
SESSION_LIFETIME=7200
CSRF_TOKEN_LIFETIME=3600
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=pdf,doc,docx,xls,xlsx,txt
UPLOAD_PATH=/workspace/uploads

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME="GovTribe Platform"
SMTP_FROM_EMAIL=noreply@yourcompany.com

# Backup Configuration
BACKUP_PATH=/workspace/backups
BACKUP_RETENTION_DAYS=30

# Logging Configuration
LOG_LEVEL=debug
LOG_PATH=/workspace/storage/logs