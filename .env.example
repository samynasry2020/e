# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=govtribe_platform
DB_USER=govtribe_user
DB_PASS=secure_password

# SAM.gov API Configuration
SAM_API_KEY=your_sam_api_key_here
SAM_API_ENDPOINT=https://api.sam.gov/opportunities/v2/search
SAM_API_ALPHA_ENDPOINT=https://api-alpha.sam.gov/opportunities/v2/search
SAM_USE_ALPHA=false

# Application Configuration
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Los_Angeles
APP_URL=https://your-domain.com

# Security
SESSION_LIFETIME=7200
CSRF_TOKEN_NAME=csrf_token
PASSWORD_HASH_ALGO=PASSWORD_ARGON2ID

# File Storage
FILES_ROOT=/var/www/app/storage/uploads
FILES_MAX_SIZE=104857600
FILES_ALLOWED_TYPES=pdf,doc,docx,xls,xlsx,txt

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=smtp_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="GovTribe Platform"

# Backup Configuration
BACKUP_RETENTION_DAYS=30