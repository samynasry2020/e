{
    "name": "govtribe-platform/private-platform",
    "description": "Private GovTribe-style platform for federal contract opportunities",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "setup": [
            "php scripts/setup.php"
        ]
    }
}