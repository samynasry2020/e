# GovTribe Platform Environment Configuration
# Copy this file to .env and update with your actual values

# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=govtribe_platform
DB_USERNAME=root
DB_PASSWORD=

# SAM.gov API
SAM_API_KEY=your_sam_api_key_here
SAM_API_BASE_URL=https://api.sam.gov/opportunities/v2
SAM_API_ALPHA_URL=https://api-alpha.sam.gov/opportunities/v2

# Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_EMAIL=noreply@govtribe.local
MAIL_FROM_NAME=GovTribe Platform

# Logging
LOG_LEVEL=info

# Security (generate new values for production)
APP_KEY=your_32_character_secret_key_here
SESSION_ENCRYPTION_KEY=your_32_character_session_key_here