{
    "name": "govtribe/platform",
    "description": "Private GovTribe-style platform for federal contract management",
    "type": "project",
    "version": "1.0.0",
    "license": "proprietary",
    "authors": [
        {
            "name": "GovTribe Platform",
            "email": "admin@govtribe.local"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "GovTribe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GovTribe\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "ingest": "php jobs/sam_ingest.php",
        "digest": "php jobs/email_digest.php",
        "cleanup": "php jobs/cleanup.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}